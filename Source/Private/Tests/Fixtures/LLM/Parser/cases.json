{
  "about": "Cases for NodeToCode.LLM.Parse.Fixtures (N2CParserFixtures.spec.cpp). Each case runs the provider's parser on one fixture body. http_status > 0 sends the body through FN2CTranslationError::WrapHttpErrorBody first, as the HTTP handler does for a non-2xx answer. expect.ok true: the answer parses into the graph; otherwise expect.kind is the EN2CTranslationErrorKind name. known_defect names the finding and the card that fixes it; the case then runs as xIt (disabled) until that card enables it.",
  "graph": {
    "graph_name": "EventGraph",
    "graph_type": "EventGraph",
    "graph_class": "BP_N2CProviderMatrix_111346",
    "implementation_has": "The PrintString node is not connected to an execution flow"
  },
  "cases": [
    { "name": "Anthropic: thinking block then text parses", "parser": "anthropic", "file": "anthropic/success_thinking_text.json",
      "expect": { "ok": true, "input_tokens": 5120, "output_tokens": 412 } },
    { "name": "Anthropic: a json-fenced answer parses", "parser": "anthropic", "file": "anthropic/success_fenced.json",
      "expect": { "ok": true } },
    { "name": "Anthropic: a fenced answer followed by a newline parses", "parser": "anthropic", "file": "anthropic/fenced_trailing_newline.json",
      "expect": { "ok": true } },
    { "name": "Anthropic: a sentence before the fenced answer is skipped", "parser": "anthropic", "file": "anthropic/preamble_fenced.json",
      "known_defect": "llm-layer-12: a leading sentence before the ```json fence fails the parse (card 0185)",
      "expect": { "ok": true } },
    { "name": "Anthropic: stop_reason max_tokens is Truncated", "parser": "anthropic", "file": "anthropic/max_tokens.json",
      "expect": { "kind": "Truncated", "provider_type": "max_tokens", "message_has": ["Anthropic > Max Output Tokens"] } },
    { "name": "Anthropic: stop_reason refusal is Refused", "parser": "anthropic", "file": "anthropic/refusal.json",
      "expect": { "kind": "Refused", "provider_type": "refusal", "message_has": ["This request was declined."] } },
    { "name": "Anthropic: a graph without graph_name parses with an empty name", "parser": "anthropic", "file": "anthropic/graph_name_missing.json",
      "expect": { "ok": true, "graph_name": "" } },
    { "name": "Anthropic: HTTP 400 invalid_request_error is InvalidRequest", "parser": "anthropic", "file": "anthropic/error_400.json", "http_status": 400,
      "expect": { "kind": "InvalidRequest", "provider_type": "invalid_request_error", "message_has": ["max_tokens: 64001 > 64000"] } },
    { "name": "Anthropic: HTTP 401 authentication_error is Auth", "parser": "anthropic", "file": "anthropic/error_401.json", "http_status": 401,
      "expect": { "kind": "Auth", "provider_type": "authentication_error", "message_has": ["invalid x-api-key"] } },
    { "name": "Anthropic: HTTP 429 rate_limit_error is RateLimited", "parser": "anthropic", "file": "anthropic/error_429.json", "http_status": 429,
      "expect": { "kind": "RateLimited", "provider_type": "rate_limit_error", "request_id": "req_011N2CFixture429" } },
    { "name": "Anthropic: HTTP 529 overloaded_error is Overloaded", "parser": "anthropic", "file": "anthropic/error_529.json", "http_status": 529,
      "expect": { "kind": "Overloaded", "provider_type": "overloaded_error", "message_has": ["Overloaded"] } },

    { "name": "OpenAI: a Chat Completions answer parses", "parser": "openai", "file": "openai/chat_success.json",
      "expect": { "ok": true, "input_tokens": 5120, "output_tokens": 412 } },
    { "name": "OpenAI: an answer in a bare fence parses", "parser": "openai", "file": "openai/chat_bare_fence.json",
      "known_defect": "llm-layer-12: only a ```json fence is stripped, not a bare ``` fence (card 0185)",
      "expect": { "ok": true } },
    { "name": "OpenAI: finish_reason length is Truncated", "parser": "openai", "file": "openai/chat_length.json",
      "expect": { "kind": "Truncated", "provider_type": "length", "message_has": ["OpenAI > Max Output Tokens"] } },
    { "name": "OpenAI: a message refusal is Refused", "parser": "openai", "file": "openai/chat_refusal.json",
      "expect": { "kind": "Refused", "provider_type": "refusal", "message_has": ["I'm sorry, I can't help with that."] } },
    { "name": "OpenAI: a numeric graph_name is read as text", "parser": "openai", "file": "openai/chat_graph_name_number.json",
      "expect": { "ok": true, "graph_name": "42" } },
    { "name": "OpenAI: a null graph_name parses with an empty name", "parser": "openai", "file": "openai/chat_graph_name_null.json",
      "expect": { "ok": true, "graph_name": "" } },
    { "name": "OpenAI: a Responses API answer after a reasoning item parses", "parser": "openai", "file": "openai/responses_reasoning_success.json",
      "expect": { "ok": true, "input_tokens": 5120, "output_tokens": 412 } },
    { "name": "OpenAI: a Responses API answer incomplete at max_output_tokens is Truncated", "parser": "openai", "file": "openai/responses_incomplete.json",
      "expect": { "kind": "Truncated", "provider_type": "max_output_tokens", "message_has": ["OpenAI > Max Output Tokens"] } },
    { "name": "OpenAI: HTTP 400 unsupported_parameter is InvalidRequest", "parser": "openai", "file": "openai/error_400.json", "http_status": 400,
      "expect": { "kind": "InvalidRequest", "provider_type": "invalid_request_error", "message_has": ["'temperature' is not supported"] } },
    { "name": "OpenAI: HTTP 401 invalid_api_key is Auth", "parser": "openai", "file": "openai/error_401.json", "http_status": 401,
      "expect": { "kind": "Auth", "message_has": ["Incorrect API key provided"] } },
    { "name": "OpenAI: HTTP 429 rate_limit_exceeded is RateLimited", "parser": "openai", "file": "openai/error_429.json", "http_status": 429,
      "expect": { "kind": "RateLimited", "message_has": ["Rate limit reached"] } },
    { "name": "OpenAI: HTTP 503 server_error is a retryable Server error", "parser": "openai", "file": "openai/error_503.json", "http_status": 503,
      "expect": { "kind": "Server", "provider_type": "server_error", "message_has": ["overloaded"] } },

    { "name": "Gemini: an answer split over several parts after a thought part parses", "parser": "gemini", "file": "gemini/success_multipart.json",
      "expect": { "ok": true, "input_tokens": 5120 } },
    { "name": "Gemini: output tokens include thoughtsTokenCount", "parser": "gemini", "file": "gemini/success_multipart.json",
      "known_defect": "llm-layer-27: Gemini usage counts only candidatesTokenCount, not thoughtsTokenCount (card 0185)",
      "expect": { "ok": true, "output_tokens": 668 } },
    { "name": "Gemini: finishReason MAX_TOKENS is Truncated", "parser": "gemini", "file": "gemini/max_tokens.json",
      "expect": { "kind": "Truncated", "provider_type": "MAX_TOKENS", "message_has": ["Gemini > Max Output Tokens"] } },
    { "name": "Gemini: finishReason SAFETY is Blocked", "parser": "gemini", "file": "gemini/safety.json",
      "expect": { "kind": "Blocked", "provider_type": "SAFETY" } },
    { "name": "Gemini: HTTP 400 INVALID_ARGUMENT (unknown additionalProperties) is InvalidRequest", "parser": "gemini", "file": "gemini/error_400.json", "http_status": 400,
      "expect": { "kind": "InvalidRequest", "provider_type": "INVALID_ARGUMENT", "message_has": ["Unknown name \"additionalProperties\""] } },
    { "name": "Gemini: HTTP 401 UNAUTHENTICATED is Auth", "parser": "gemini", "file": "gemini/error_401.json", "http_status": 401,
      "expect": { "kind": "Auth", "provider_type": "UNAUTHENTICATED" } },
    { "name": "Gemini: HTTP 429 RESOURCE_EXHAUSTED is RateLimited", "parser": "gemini", "file": "gemini/error_429.json", "http_status": 429,
      "expect": { "kind": "RateLimited", "provider_type": "RESOURCE_EXHAUSTED", "message_has": ["You exceeded your current quota"] } },
    { "name": "Gemini: HTTP 503 UNAVAILABLE is Overloaded", "parser": "gemini", "file": "gemini/error_503.json", "http_status": 503,
      "expect": { "kind": "Overloaded", "provider_type": "UNAVAILABLE" } },

    { "name": "DeepSeek: an answer next to reasoning_content parses", "parser": "deepseek", "file": "deepseek/success_reasoning.json",
      "expect": { "ok": true, "input_tokens": 5120, "output_tokens": 412 } },
    { "name": "DeepSeek: finish_reason length while reasoning is Truncated", "parser": "deepseek", "file": "deepseek/length.json",
      "expect": { "kind": "Truncated", "provider_type": "length", "message_has": ["DeepSeek > Max Output Tokens"] } },
    { "name": "DeepSeek: HTTP 400 invalid_request_error is InvalidRequest", "parser": "deepseek", "file": "deepseek/error_400.json", "http_status": 400,
      "expect": { "kind": "InvalidRequest", "message_has": ["Invalid max_tokens value"] } },
    { "name": "DeepSeek: HTTP 401 authentication_error is Auth", "parser": "deepseek", "file": "deepseek/error_401.json", "http_status": 401,
      "expect": { "kind": "Auth", "provider_type": "authentication_error", "message_has": ["Authentication Fails"] } },
    { "name": "DeepSeek: HTTP 429 rate_limit_error is RateLimited", "parser": "deepseek", "file": "deepseek/error_429.json", "http_status": 429,
      "expect": { "kind": "RateLimited", "message_has": ["Rate Limit Reached"] } },

    { "name": "Ollama: an answer next to thinking parses", "parser": "ollama", "file": "ollama/success_thinking.json",
      "expect": { "ok": true } },
    { "name": "Ollama: a json-fenced answer parses", "parser": "ollama", "file": "ollama/success_fenced.json",
      "expect": { "ok": true } },
    { "name": "Ollama: done_reason length is Truncated", "parser": "ollama", "file": "ollama/length.json",
      "expect": { "kind": "Truncated", "provider_type": "length" } },
    { "name": "Ollama: a string-typed error (HTTP 404) keeps its text", "parser": "ollama", "file": "ollama/error_404_string.json", "http_status": 404,
      "expect": { "kind": "InvalidRequest", "message_has": ["model \"qwen3:32b\" not found"] } },
    { "name": "Ollama: a string-typed error with HTTP 200 keeps its text", "parser": "ollama", "file": "ollama/error_404_string.json",
      "expect": { "kind": "Unknown", "message_has": ["model \"qwen3:32b\" not found"] } },

    { "name": "LM Studio: an answer parses", "parser": "lmstudio", "file": "lmstudio/success.json",
      "expect": { "ok": true, "input_tokens": 5120, "output_tokens": 412 } },
    { "name": "LM Studio: content null with finish_reason length is Truncated", "parser": "lmstudio", "file": "lmstudio/length.json",
      "expect": { "kind": "Truncated", "provider_type": "length", "message_has": ["LM Studio > Max Output Tokens"] } },
    { "name": "LM Studio: a string-typed error (HTTP 400) keeps its text", "parser": "lmstudio", "file": "lmstudio/error_400_string.json", "http_status": 400,
      "expect": { "kind": "InvalidRequest", "message_has": ["is not loaded"] } },
    { "name": "LM Studio: a string-typed error with HTTP 200 keeps its text", "parser": "lmstudio", "file": "lmstudio/error_400_string.json",
      "expect": { "kind": "Unknown", "message_has": ["is not loaded"] } }
  ]
}
