{
	"case": "DisabledNodes",
	"description": "Function Disabled(Value): the entry runs CollectGarbage, then a Print String the user disabled (its In String from To String (Integer) of Value), then ControlScreensaver set to Development Only, then a disabled Branch whose True runs ResetGamepadAssignments. Exec passes through the disabled Print String (one exec input, one exec output) to ControlScreensaver; the disabled Branch ends the chain, so ResetGamepadAssignments is unreachable and To String, read only by the disabled Print String, is unused.",
	"known_defects": [
		{
			"finding": "gap-5",
			"card": "0138",
			"effect": "Node and pin names are display text (menu titles, friendly pin names, blank exec pin names), not stable identifiers, so they change with editor language and settings"
		}
	],
