{
	"case": "Recursion_Depth2",
	"description": "Max Translation Depth 2. Function Root(Count) calls Child, then itself with Count; Child calls Grandchild; Grandchild calls Root. Captured from Root.",
	"translation_depth": 2,
	"known_defects": [
		{
			"finding": "translation-core-9",
			"card": "0134",
			"effect": "Root calls itself before Root is in the graph list, so Root is captured twice; the second copy reuses node IDs N1-N3 and gives every pin the same ID (P10, also Child's entry exec pin), and the validator logs ERROR 'Duplicate pin ID' (expected errors in this case)"
		},
		{
			"finding": "translation-core-2",
			"card": "0136",
			"effect": "Execution flows are 'N1->N2' node pairs: which exec output and which exec input a link uses is lost, and two outputs into one node collapse to one entry"
		},
		{
			"finding": "translation-core-7",
			"card": "0134",
			"effect": "Pin IDs are one global counter (P1..Pn across the graph) keyed by pin GUID, and node IDs depend on traversal order"
		},
		{
			"finding": "gap-5",
			"card": "0138",
			"effect": "Node and pin names are display text (menu titles, friendly pin names, blank exec pin names), not stable identifiers, so they change with editor language and settings"
		}
	],
