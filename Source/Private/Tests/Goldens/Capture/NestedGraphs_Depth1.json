{
	"case": "NestedGraphs_Depth1",
	"description": "Max Translation Depth 1. Function Nested(): the entry runs a collapsed graph GoldenCollapsed (In -> CollectGarbage -> Out), whose Out runs the Blueprint's own macro LocalSteps (In -> ControlScreensaver -> Out).",
	"translation_depth": 1,
	"known_defects": [
		{
			"finding": "imp-translation-core-5",
			"card": "0235",
			"effect": "Collapsed graphs and the Blueprint's own macros only count as nested graphs within the depth limit: at depth 0 (the default) GoldenCollapsed and LocalSteps are not captured and only the opaque Composite and MacroInstance nodes remain"
		},
		{
			"finding": "imp-translation-core-4",
			"card": "0235",
			"effect": "The Composite and MacroInstance nodes do not name the graph captured for them (the Composite has no member_parent or member_name)"
		},
		{
			"finding": "translation-core-20",
			"card": "0235",
			"effect": "A user macro is classed as a Macro graph only when its name contains 'macro': LocalSteps comes out as an EventGraph"
		},
		{
			"finding": "translation-core-2",
			"card": "0136",
			"effect": "Execution flows are 'N1->N2' node pairs: which exec output and which exec input a link uses is lost, and two outputs into one node collapse to one entry"
		},
		{
			"finding": "translation-core-7",
			"card": "0134",
			"effect": "Pin IDs are one global counter (P1..Pn across the graph) keyed by pin GUID, and node IDs depend on traversal order"
		},
		{
			"finding": "gap-5",
			"card": "0138",
			"effect": "Node and pin names are display text (menu titles, friendly pin names, blank exec pin names), not stable identifiers, so they change with editor language and settings"
		}
	],
