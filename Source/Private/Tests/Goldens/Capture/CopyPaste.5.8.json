{
	"case": "CopyPaste",
	"description": "Function CopyPaste(Enabled): the entry runs ControlScreensaver (bAllowScreenSaver from Enabled), which runs a copy-pasted duplicate of itself (pasted as the editor does: new node GUID, pin IDs kept), also fed from Enabled.",
	"known_defects": [
		{
			"finding": "translation-core-7",
			"card": "0134",
			"effect": "Pin IDs are keyed by pin GUID, which a paste keeps: every pin of the pasted node gets the same ID (P6), its flows point at that one ID and the validator logs ERROR 'Duplicate pin ID' (expected errors in this case)"
		},
		{
			"finding": "translation-core-1 (PR #7, issue #13)",
			"card": "0135",
			"effect": "flows.data is keyed by one end of each link, so an output feeding several inputs keeps only the last edge recorded; the other inputs say connected with no source"
		},
		{
			"finding": "translation-core-2",
			"card": "0136",
			"effect": "Execution flows are 'N1->N2' node pairs: which exec output and which exec input a link uses is lost, and two outputs into one node collapse to one entry"
		},
		{
			"finding": "gap-5",
			"card": "0138",
			"effect": "Node and pin names are display text (menu titles, friendly pin names, blank exec pin names), not stable identifiers, so they change with editor language and settings"
		}
	],
