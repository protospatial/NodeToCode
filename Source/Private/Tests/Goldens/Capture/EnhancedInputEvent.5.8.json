{
	"case": "EnhancedInputEvent",
	"description": "Event graph: the Enhanced Input action event for a transient UInputAction IA_GoldenJump (Boolean); Triggered runs CollectGarbage, Completed runs ControlScreensaver.",
	"known_defects": [
		{
			"finding": "translation-core-15",
			"card": "0234",
			"effect": "The Enhanced Input action event is typed CallFunction, with no member_parent or member_name, instead of an event"
		},
		{
			"finding": "translation-core-18, translation-core-19 (issue #13)",
			"card": "0137",
			"effect": "The grayed-out default events CreateBlueprint places (BeginPlay, ActorBeginOverlap, Tick) are captured as live events (N1-N3), and unreachable nodes are not marked"
		},
		{
			"finding": "translation-core-2",
			"card": "0136",
			"effect": "Execution flows are 'N1->N2' node pairs: which exec output and which exec input a link uses is lost, and two outputs into one node collapse to one entry"
		},
		{
			"finding": "gap-5",
			"card": "0138",
			"effect": "Node and pin names are display text (menu titles, friendly pin names, blank exec pin names), not stable identifiers, so they change with editor language and settings"
		}
	],
