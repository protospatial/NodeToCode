{
	"case": "UserStruct",
	"description": "Function UseItem(Item: S_GoldenItem): S_GoldenItem is a user struct {Owner: Actor object, Count: int, Level: user enum E_GoldenLevel {Low, High}}. Break S_GoldenItem feeds Count to the Count result and Owner, Count and Level to Make S_GoldenItem, which is the Copy result.",
	"known_defects": [
		{
			"finding": "translation-core-8",
			"card": "0236",
			"effect": "S_GoldenItem is missing from 'structs': its object member Owner gets no type name, the validator rejects the struct (ERROR 'Member Owner requires a type name') and it is dropped without a warning"
		},
		{
			"finding": "translation-core-24",
			"card": "0236",
			"effect": "A user struct or enum met a second time comes back empty and the validator logs ERROR 'Missing name' (expected errors in this case)"
		},
		{
			"finding": "translation-core-4",
			"card": "0234",
			"effect": "Break S_GoldenItem is captured as a Variable named 'None' with member_parent object/Actor (the first member's type) and member_name Var_<graph>_<UObject index> (normalised to <OBJECT_INDEX>)"
		},
		{
			"finding": "translation-core-1 (PR #7, issue #13)",
			"card": "0135",
			"effect": "flows.data is keyed by one end of each link, so an output feeding several inputs keeps only the last edge recorded; the other inputs say connected with no source"
		},
		{
			"finding": "translation-core-7",
			"card": "0134",
			"effect": "Pin IDs are one global counter (P1..Pn across the graph) keyed by pin GUID, and node IDs depend on traversal order"
		},
		{
			"finding": "gap-5",
			"card": "0138",
			"effect": "Node and pin names are display text (menu titles, friendly pin names, blank exec pin names), not stable identifiers, so they change with editor language and settings"
		}
	],
